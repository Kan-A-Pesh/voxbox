{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VoxBox",
  "mainBinaryName": "voxbox",
  "version": "0.1.0",
  "identifier": "com.voxbox.app",
  "build": {
    "beforeDevCommand": "pnpm --dir ui dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm --dir ui build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "VoxBox",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 700,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; media-src 'self' https://www.myinstants.com https://myinstants.com; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "resources": {
      "../installer/resources/": "resources/"
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "languages": ["French"],
        "installerHooks": "../installer/hooks.nsh"
      }
    }
  }
}
